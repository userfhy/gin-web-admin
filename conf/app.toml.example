[app]
JwtSecret = ""
# If there is a user record, please do not change it at will
PasswordSalt = "fgyf"
PrefixUrl = "http://0.0.0.0:8081"
TimeFormat = "20060102"
ExpireTimeFormat = "2006/01/02 15:04:05"
EnabledCORS = true

[server]
# Running in "debug" mode. Switch to "release" mode in production.
# Debug mode no routing authority verification.
#debug or release
RunMode = "debug"
HttpPort = 8081
ReadTimeout = 60
WriteTimeout = 60

[database]
EchoSql = true
Type = "mysql"
User = "root"
Password = "pass"
Host = "127.0.0.1:3306"
Name = "name"
TablePrefix = "gin_"

[redis]
# Host not "" enable
Host = ""
DB = 3
Password = ""
MaxIdle = 30
MaxActive = 30
IdleTimeout = 200

[security]
# Basic password complexity & login safety policies
PasswordMinLength = 8
RequireUppercase = true
RequireLowercase = true
RequireNumber = false
RequireSpecial = false
# After LoginMaxAttempts failures lock account for LoginLockoutMinutes
LoginMaxAttempts = 5
LoginLockoutMinutes = 15
# Leave empty to allow all IPs; support single IP or CIDR
IPWhitelist = ["127.0.0.1/32", "::1"]

[site]
# Default ttl for site related caches (Go duration format)
CacheTTL = "15m"
