#!/usr/bin/env bash
set -euo pipefail

if [[ "${SKIP_GIT_HOOKS:-0}" == "1" ]]; then
	echo "SKIP_GIT_HOOKS=1 detected, skip checks" >&2
	exit 0
fi

if ! command -v golangci-lint >/dev/null 2>&1; then
	echo "[pre-commit] golangci-lint 未安装，或设置 SKIP_GIT_HOOKS=1 后重试" >&2
	exit 1
fi

echo "[pre-commit] golangci-lint run"
golangci-lint run

echo "[pre-commit] go test ./..."
GOCACHE=${GOCACHE:-/tmp/gocache} go test ./...

echo "[pre-commit] done"
